{
  "name": "SajjanMart",
  "version": "0.0.1",
  "private": true,
"scripts": {
  "android": "react-native run-android",
  "android:debug": "cd android && gradlew.bat assembleDebug",
  "android:debug:standalone": "react-native bundle --platform android --dev true --entry-file index.js --bundle-output android/app/src/debug/assets/index.android.bundle --assets-dest android/app/src/debug/res --reset-cache && cd android && gradlew.bat assembleDebug",
  "android:debug:clean": "cd android && gradlew.bat clean && gradlew.bat assembleDebug",
  "android:release": "cd android && gradlew.bat assembleRelease",
  "android:clean": "cd android && gradlew.bat clean",
  "android:release:clean": "cd android && gradlew.bat clean && gradlew.bat assembleRelease",
  "ios": "react-native run-ios",
  "lint": "eslint .",
  "start": "react-native start",
  "test": "jest"
},
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-firebase/app": "^26.2.0",
    "@react-native-firebase/messaging": "^26.2.0",
    "@react-native/new-app-screen": "0.87.0",
    "@tanstack/react-query": "^5.102.3",
    "react": "19.2.3",
    "react-native": "0.87.0",
    "react-native-safe-area-context": "^5.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.0",
    "@react-native/eslint-config": "0.87.0",
    "@react-native/jest-preset": "0.87.0",
    "@react-native/metro-config": "0.87.0",
    "@react-native/typescript-config": "0.87.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "reactotron-react-native": "^5.3.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
