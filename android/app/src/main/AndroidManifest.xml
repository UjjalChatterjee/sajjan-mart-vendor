<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Android 14+ requires a matching permission for every foreground service
         type used. NativeOrderApiService submits one order decision over the
         network, which is dataSync. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Required for setBypassDnd() to take effect. Without this permission,
         the channel's DND-bypass request is silently ignored by the OS.
         The user must still grant access in system settings. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- Required for fullScreenIntent (heads-up on locked screen) on Android 14+ -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"        android:theme="@style/AppTheme.Splash"
        android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:networkSecurityConfig="@xml/network_security_config"
      android:supportsRtl="true">
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity>

      <!-- The library's ReactNativeFirebaseMessagingService handles onNewToken
           and other Firebase messaging callbacks. Do NOT remove it. -->

      <!-- Replace the library's ReactNativeFirebaseMessagingReceiver with our
           CustomMessagingReceiver. It intercepts NEW_ORDER messages and starts
           OrderAlertService natively for background/killed states, then delegates
           to super for normal JS dispatch (foreground modal, background handler). -->
      <receiver
        android:name="io.invertase.firebase.messaging.ReactNativeFirebaseMessagingReceiver"
        tools:node="remove" />

      <receiver
        android:name=".CustomMessagingReceiver"
        android:exported="true"
        android:permission="com.google.android.c2dm.permission.SEND">
        <intent-filter>
            <action android:name="com.google.android.c2dm.intent.RECEIVE" />
        </intent-filter>
      </receiver>

      <!-- Notification action receiver -->
      <receiver
        android:name=".NotificationActionReceiver"
        android:exported="false">
        <intent-filter>
            <action android:name="com.sajjanmart.ORDER_ACCEPT" />
            <action android:name="com.sajjanmart.ORDER_REJECT" />
        </intent-filter>
      </receiver>

      <!-- Headless JS service for killed-app notification actions -->
      <service
        android:name=".NotificationActionService"
        android:exported="false" />

      <!-- Native API service for killed-app ACCEPT/REJECT actions.
           Calls the order API directly without React Native JS runtime.
           Runs as a foreground service: the receiver that starts it can be the
           only thing keeping the process alive, and a background startService
           from there is restricted (throws on Android 12+), which used to lose
           the tap entirely. -->
      <service
        android:name=".NativeOrderApiService"
        android:exported="false"
        android:foregroundServiceType="dataSync" />

      <!-- Foreground service for continuous order alert playback -->
      <service
        android:name=".OrderAlertService"
        android:exported="false"
        android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>
